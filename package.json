{
  "name": "on-call",
  "private": true,
  "version": "0.1.0",
  "description": "Hands-free Claude Code via phone. Twilio + on-device Gemma 4 (Cactus) + Telegram bridge.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "pnpm -r --parallel build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "lint": "pnpm -r --parallel lint",
    "dev:bridge": "pnpm --filter @on-call/bridge dev",
    "dev:agent": "pnpm --filter @on-call/voice-agent start",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
