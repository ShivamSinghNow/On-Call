# ---- apps/bridge ----

# Port the bridge server listens on
BRIDGE_PORT=4000

# Shared secret sent by the mobile app in the x-bridge-token header
BRIDGE_TOKEN=dev-secret-change-me

# How the bridge reaches the existing Telegram <-> Claude Code bot.
#   local    -> HTTP to an internal endpoint on the bot process (recommended)
#   telegram -> fallback: post to the bot via Telegram Bot API and poll for replies
CLAUDE_BRIDGE_MODE=local

# mode=local: URL of the existing bot's internal HTTP endpoint
CLAUDE_LOCAL_URL=http://localhost:5055/internal/ask

# mode=telegram: used only if CLAUDE_BRIDGE_MODE=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_RELAY_CHAT_ID=

# Per-request timeout for Claude replies (ms)
CLAUDE_TIMEOUT_MS=120000

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# ---- apps/mobile ----

# URL of the bridge as seen from the phone (LAN IP during dev, not localhost)
EXPO_PUBLIC_BRIDGE_URL=http://192.168.1.10:4000
EXPO_PUBLIC_BRIDGE_TOKEN=dev-secret-change-me
