# --- Bridge server ---

# HTTP/WebSocket port the bridge listens on
PORT=3000

# Public URL the bridge is reachable at (used in TwiML responses).
# In dev: use ngrok or similar (e.g. https://abc123.ngrok.app).
PUBLIC_URL=https://your-bridge.example.com

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# --- Twilio ---

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15555550123

# Polly voice for spoken responses. See: https://www.twilio.com/docs/voice/twiml/say/text-speech#available-voices-and-languages
TWILIO_TTS_VOICE=Polly.Joanna-Neural

# --- Telegram bot (the existing Claude Code relay) ---

# Bot token of the Telegram bot connected to your Claude Code session.
TELEGRAM_BOT_TOKEN=123456:ABCDEFxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The chat ID where the Claude Code bot lives.
# To find it: send a message to your bot, then GET https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=-1001234567890

# How long to wait for Claude Code's reply before timing out (ms).
CLAUDE_CODE_TIMEOUT_MS=60000

# --- Voice agent shared secret ---

# Pre-shared token the React Native voice-agent app sends to authenticate
# its outbound WebSocket connection to /agent.
AGENT_AUTH_TOKEN=change-me-to-a-random-secret

# --- Voice agent app (React Native) ---
# These are read from the app's runtime config / app.json; documented here for reference.

# WebSocket URL the RN app dials to reach the bridge.
EXPO_PUBLIC_BRIDGE_WS_URL=wss://your-bridge.example.com/agent
EXPO_PUBLIC_AGENT_AUTH_TOKEN=change-me-to-a-random-secret

# URL (Cactus will download on first launch) or on-device absolute path
# to the Gemma 4 E2B GGUF weights and its multimodal projector file.
# See https://docs.cactuscompute.com/latest/blog/gemma4/ for canonical asset URLs.
EXPO_PUBLIC_GEMMA_MODEL_PATH=https://huggingface.co/<org>/gemma-4-E2B-gguf/resolve/main/gemma-4-E2B.gguf
EXPO_PUBLIC_GEMMA_MMPROJ_PATH=https://huggingface.co/<org>/gemma-4-E2B-gguf/resolve/main/mmproj.gguf
