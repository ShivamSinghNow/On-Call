# ---- apps/channel ----

# Port the channel server listens on (phone connects to this over LAN)
BRIDGE_PORT=4000

# Shared secret sent by the mobile app in the x-bridge-token header
BRIDGE_TOKEN=dev-secret-change-me

# Public URL of this server (set to your ngrok URL after running: ngrok http 4000)
PUBLIC_URL=https://xxxx.ngrok-free.app

# Twilio credentials (from console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- apps/mobile ----

# URL of the channel server as seen from the phone (LAN IP, not localhost)
EXPO_PUBLIC_BRIDGE_URL=http://192.168.1.10:4000
EXPO_PUBLIC_BRIDGE_TOKEN=dev-secret-change-me
